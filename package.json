{
  "name": "roundtable",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "lint": "oxlint --max-warnings=0 .",
    "lint:fix": "oxlint --fix --max-warnings=0 .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "typecheck": "npm run generate-routes && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "generate:proto": "cd schemas && buf generate && cd .. && oxfmt --write src/demo/generated",
    "verify:demo": "node --experimental-transform-types scripts/verify-demo.ts",
    "verify:roster": "node --experimental-transform-types scripts/verify-demo.ts --roster",
    "verify:round": "node --experimental-transform-types scripts/verify-demo.ts --round"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.15.0",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "dexie": "^4.4.6",
    "effect": "^3.22.2",
    "pixi.js": "^8.21.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "snappyjs": "^0.7.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protoc-gen-es": "^2.15.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "latest",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/snappyjs": "^0.7.1",
    "@vitejs/plugin-react": "^6.0.1",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
